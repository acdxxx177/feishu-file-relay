# 生产脚本精确读取本文件对应的.env，不会用.dev.vars覆盖凭据。
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
PUBLIC_BASE_URL=https://dl.example.com
# 以下仅供手动真实环境验收，pnpm smoke需通过进程环境传入。
DOWNLOAD_URL=https://dl.example.com/f/replace-with-22-char-id
# 上传前原文件SHA256：(Get-FileHash -Algorithm SHA256 -LiteralPath '文件路径').Hash
EXPECTED_SHA256=replace-with-original-file-sha256
