# 生产脚本精确读取本文件对应的.env，不会用.dev.vars覆盖凭据。
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_VERIFICATION_TOKEN=replace-with-verification-token
FEISHU_ENCRYPT_KEY=replace-with-encrypt-key
PUBLIC_BASE_URL=https://dl.example.com
# 以下仅供手动真实环境验收，pnpm smoke需通过进程环境传入。
DOWNLOAD_URL=https://dl.example.com/f/replace-with-22-char-id
# 上传前原文件SHA256：(Get-FileHash -Algorithm SHA256 -LiteralPath '文件路径').Hash
EXPECTED_SHA256=replace-with-original-file-sha256

# VPS：仅进程环境或本机受保护文件读取；不要将 Token 写进命令参数。
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_DATABASE_ID=replace-with-existing-database-id
CLOUDFLARE_D1_TOKEN=replace-with-d1-api-token
HOST=127.0.0.1
PORT=3000
FEISHU_INTAKE_POLICY=platform
FEISHU_TRANSPORT=real
FEISHU_API_BASE=https://open.feishu.cn
FEISHU_ACCOUNTS_BASE=https://accounts.feishu.cn
MAX_FILE_SIZE=1073741824
UPSTREAM_READ_TIMEOUT_MS=30000
WEBHOOK_MAX_SKEW_SECONDS=300
D1_REQUEST_BUDGET=900
MAX_CONCURRENT_DOWNLOADS=10
DOWNLOAD_RATE_LIMIT=60
CHUNK_CACHE_ENABLED=false
# 仅在 Node 只监听回环地址且 Nginx 重写 X-Real-IP 时启用。
TRUST_PROXY=true
# 非回环反向代理需明确列出 IP；不接受 CIDR。Docker 配置见 pnpm env:docker。
TRUSTED_PROXY_IPS=
SHUTDOWN_TIMEOUT_MS=60000
JOB_POLL_MS=15000
