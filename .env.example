# 在仓库根目录执行 Copy-Item .env.example .env，再用编辑器填写 .env。
# 真实值只填在本地 .env 中。以下配置供后续测试使用。

# 飞书测试用自建应用 → 凭证与基础信息。测试程序将用这两项获取短期访问令牌。
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书应用的事件订阅配置。验证回调时填写 Verification Token；
# 启用了事件加密才填写 Encrypt Key，否则留空。
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=

# 回调联调时填写允许登记文件的机器人单聊 chat_id，多个用英文逗号分隔。
# 留空表示不允许登记。此限制只用于上传入口，客户下载无需凭证。
FEISHU_ALLOWED_CHAT_IDS=

# 联调时替换成测试 Gateway 的公网 HTTPS 地址，只填协议和域名。
# 飞书事件订阅地址是在此地址后加 /webhook/feishu。
PUBLIC_BASE_URL=https://dl.example.com

# M1 分片读取与完整性测试（PRD §11）。有测试附件后再填。
# 每组的 message_id 和 file_key 必须来自同一条测试文件消息。
# SHA-256 应取自发送前的原文件，可用 (Get-FileHash -Algorithm SHA256 -LiteralPath '文件路径').Hash 获取。
TEST_100MB_MESSAGE_ID=
TEST_100MB_FILE_KEY=
TEST_100MB_SHA256=

TEST_500MB_MESSAGE_ID=
TEST_500MB_FILE_KEY=
TEST_500MB_SHA256=

TEST_1GB_MESSAGE_ID=
TEST_1GB_FILE_KEY=
TEST_1GB_SHA256=
