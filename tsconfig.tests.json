{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["tests/**/*.ts", "mocks/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["tests/vps", "scripts/build-vps.ts", "scripts/db-schema-check.ts", "scripts/db-migrate-diff.ts", "scripts/test-d1-remote.ts"]
}
