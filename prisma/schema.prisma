generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// 保留既有 TEXT 时间格式及数据库 CHECK；迁移 SQL 才是约束的最终依据。
model File {
  id               String  @id
  messageId        String  @unique @map("message_id")
  fileKey          String  @map("file_key")
  fileName         String  @map("file_name")
  fileSize         Int?    @map("file_size")
  mimeType         String? @map("mime_type")
  uploaderOpenId   String  @map("uploader_open_id")
  chatId           String  @map("chat_id")
  version          Int     @default(1)
  status           String  @default("pending")
  failReason       String? @map("fail_reason")
  deleteReason     String? @map("delete_reason")
  attempts         Int     @default(0)
  downloadCount    BigInt  @default(0) @map("download_count")
  lastDownloadedAt String? @map("last_downloaded_at")
  createdAt        String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  updatedAt        String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("updated_at")
  deletedAt        String? @map("deleted_at")
  nextAttemptAt    BigInt  @default(0) @map("next_attempt_at")
  leaseUntil       BigInt  @default(0) @map("lease_until")

  @@index([status, createdAt], map: "idx_files_status_created")
  @@index([uploaderOpenId, createdAt], map: "idx_files_uploader")
  @@map("files")
}

model RecalledMessage {
  messageId  String @id @map("message_id")
  recalledAt String @default(dbgenerated("CURRENT_TIMESTAMP")) @map("recalled_at")
  @@map("recalled_messages")
}

model ProcessedEvent {
  eventId     String @id @map("event_id")
  processedAt String @default(dbgenerated("CURRENT_TIMESTAMP")) @map("processed_at")
  @@map("processed_events")
}

model BotJob {
  id             String  @id
  kind           String
  messageId      String? @map("message_id")
  fileId         String? @map("file_id")
  uploaderOpenId String  @map("uploader_open_id")
  chatId         String  @map("chat_id")
  argument       String
  state          String  @default("pending")
  attempts       Int     @default(0)
  nextAttemptAt  BigInt  @default(0) @map("next_attempt_at")
  leaseUntil     BigInt  @default(0) @map("lease_until")
  createdAt      String  @default(dbgenerated("CURRENT_TIMESTAMP")) @map("created_at")
  @@index([state, nextAttemptAt], map: "idx_jobs_due")
  @@map("bot_jobs")
}
