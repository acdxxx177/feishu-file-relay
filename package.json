{
  "name": "feishu-file-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm run cf-typegen && tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "pnpm run typecheck && wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "0.1.11",
    "typescript": "7.0.2",
    "wrangler": "4.156.2"
  }
}
