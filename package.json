{
  "name": "feishu-file-relay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm run build:browser && tsx watch --env-file=.env src/vps/main.ts",
    "cf-typegen": "wrangler types",
    "typecheck": "pnpm run db:generate && pnpm run build:browser && tsc -p tsconfig.vps.json && tsc -p tsconfig.browser.json",
    "build": "pnpm run db:generate && node scripts/build-vps.ts",
    "test": "pnpm run build && tsx --test --test-concurrency=1 tests/vps/*.test.ts",
    "test:large": "pnpm run build && tsx --test --test-concurrency=1 tests/vps/large/*.test.ts",
    "test:stress": "pnpm run build && tsx --test --test-concurrency=1 tests/vps/stress/*.test.ts",
    "profile:chunk": "pnpm run build:worker && node scripts/profile-chunk-cpu.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "mock:feishu": "node mocks/feishu-mock.ts",
    "smoke": "node scripts/smoke.ts",
    "online:prepare": "node scripts/online-setup.ts prepare",
    "online:deploy": "node scripts/online-setup.ts deploy",
    "online:test": "node scripts/online-test.ts",
    "online:tail": "node scripts/online-tail.ts",
    "production:prepare": "node scripts/production-setup.ts prepare",
    "production:deploy": "node scripts/production-setup.ts deploy",
    "production:verify": "node scripts/production-setup.ts verify",
    "build:mock": "wrangler deploy --config wrangler.mock.jsonc --dry-run --outdir dist/mock",
    "deploy": "node -e \"console.error('Use the VPS deployment checklist; production changes require explicit authorization.'); process.exit(1)\"",
    "build:browser": "node scripts/build-browser.ts",
    "online:deploy:browser": "node scripts/online-setup.ts deploy --browser",
    "online:test:browser": "node scripts/online-test.ts --browser",
    "online:tail:browser": "node scripts/online-tail.ts --browser",
    "build:worker": "pnpm run build:browser && wrangler deploy --dry-run --outdir dist",
    "typecheck:worker": "pnpm run build:browser && pnpm run cf-typegen && tsc --noEmit && tsc -p tsconfig.tests.json && tsc -p tsconfig.browser.json",
    "test:worker": "pnpm run build:worker && pnpm run build:mock && node --test --test-concurrency=1 tests/*.test.ts",
    "test:worker:large": "pnpm run build:worker && node --test --test-concurrency=1 tests/large/*.test.ts",
    "test:worker:stress": "pnpm run build:worker && node --test --test-concurrency=1 tests/stress/*.test.ts",
    "dev:worker": "pnpm run build:browser && wrangler dev --local --ip 127.0.0.1",
    "start": "node --env-file=.env dist/vps/main.js",
    "db:generate": "prisma generate",
    "db:check": "tsx scripts/db-schema-check.ts",
    "db:diff": "tsx scripts/db-migrate-diff.ts",
    "test:d1:remote": "tsx scripts/test-d1-remote.ts",
    "test:linux": "pnpm run build && tsx --test tests/vps/linux/*.test.ts",
    "check:health": "pnpm run build:browser && hono request tests/vps/cli-app.ts -P /health -J"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@prisma/adapter-d1": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prisma/driver-adapter-utils": "7.10.1",
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@hono/cli": "0.1.11",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261102.0-beta",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "wrangler": "4.156.2"
  }
}
